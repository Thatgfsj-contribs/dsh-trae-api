# Trae Local API 配置
# ============================================
# TRAE_EDITION 取值 (括号内为数据目录名):
#   cn      - Trae CN 国内版 (Trae CN, tc 加密)
#   solo    - TRAE SOLO CN 独立部署版 (TRAE SOLO CN, tc 加密)
#   sg      - Trae 国际版 (Trae, 明文 JSON)
#   solo-sg - TRAE SOLO 国际版 (TRAE SOLO, tc 加密)
#
# 数据目录按平台自动探测:
#   Windows: %APPDATA%\<目录名>
#   macOS:   ~/Library/Application Support/<目录名>
#   Linux:   $XDG_CONFIG_HOME/<目录名> (默认 ~/.config/<目录名>)
# 认证文件为 <数据目录>/User/globalStorage/storage.json
# ============================================

# Trae 版本 (自动检测时此值会被覆盖)
TRAE_EDITION=cn

# 本服务的 API Key (客户端请求时需携带；设为 none 可禁用鉴权，不推荐)
API_KEY=trae-local-api

# 监听端口
PORT=9220

# 监听地址 (默认 127.0.0.1 仅本机访问；设为 0.0.0.0 开放局域网，需自担风险)
# HOST=127.0.0.1

# ============================================
# 以下字段由 setup.cjs 自动填充，无需手动修改
# ============================================

# 自动解密后的 JWT Token
# TRAE_TOKEN=eyJ...

# 刷新 Token
# TRAE_REFRESH_TOKEN=...

# 用户 ID
# TRAE_USER_ID=...

# Token 过期时间 (ISO 8601)
# TRAE_TOKEN_EXPIRES=...

# Refresh Token 过期时间
# TRAE_REFRESH_EXPIRES=...

# ============================================
# 高级选项 (可选)
# ============================================

# 上游 API 地址 (一般无需修改)
# BASE_URL=https://trae-api-cn.mchost.guru

# 手动指定 Trae 数据目录 (自动探测失败时使用；可指向 <目录名> 或其中的 User 目录)
# Linux 示例:
# TRAE_DATA_DIR=/home/you/.config/Trae CN
# macOS 示例:
# TRAE_DATA_DIR="/Users/you/Library/Application Support/Trae CN"
# Windows 示例:
# TRAE_DATA_DIR=C:\Users\you\AppData\Roaming\Trae CN

# 覆盖请求头 x-device-type / x-os-version (默认按平台自动取值: linux / mac / windows)
# TRAE_DEVICE_TYPE=linux
# TRAE_OS_VERSION=6.12.0

# 最大上下文 Token 数 (默认 200000)
# MAX_CONTEXT_TOKENS=200000

# 如果自动解密失败，可手动设置 Token
# TRAE_MANUAL_TOKEN=eyJ...